# Binaries and build output
/shortfall
dist/
*.test
*.out

# Editor/OS noise
.DS_Store
.idea/
.vscode/

# Warden evidence (generated, uploaded as CI artifacts, never committed)
.warden/out/
.warden/memory/findings.jsonl
.warden/memory/gate/

# built CLI binary (nested module)
cmd/shortfall/shortfall

# built header tool (nested module)
test/licensehdr/licensehdr

# Git worktrees created by agent sessions. They live inside the repo, so
# without this a `git add -A` stages them as embedded repositories and every
# `warden verify` reports a dirty tree.
.claude/worktrees/
