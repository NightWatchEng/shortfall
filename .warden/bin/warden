#!/bin/sh
# The launcher the AgentOps skill pack calls. It runs the warden installed at
# repo.yaml's platform.pin (`uv tool install
# git+https://github.com/NightWatchEng/agentops@<platform.pin>`) and carries
# no version of its own: warden compares its version to platform.pin and fails
# closed on a mismatch. CI calls the installed `warden` directly.
exec warden "$@"
